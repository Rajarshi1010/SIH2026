# ==============================================================================
# Agnikavach (GeoAI Industrial Fire Classifier) - Environment Configuration Template
# Problem Statement: SIH26162 (National Technical Research Organisation - NTRO)
# ==============================================================================

# Application Environment
APP_NAME="Agnikavach - GeoAI Industrial Fire Classifier"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Security & CORS
SECRET_KEY=change_this_to_a_secure_32_byte_secret_key_in_production
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL 16 / TimescaleDB / PostGIS Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=geoai_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Asynchronous SQLAlchemy connection string:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/geoai_db

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# External Telemetry & Remote Sensing (NASA FIRMS)
# Request your free MAP key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_nasa_firms_map_key_here
FIRMS_API_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv

# Operational Strategic Bounding Box [min_lon, min_lat, max_lon, max_lat]
# Default covers the Indian subcontinent: 68.0, 6.0, 97.0, 36.0
OPERATIONAL_BBOX=68,6,97,36

# Layer 5: STAC API & Optical Burn-Scar Verification (Sentinel-2 L2A)
# Free open catalog provided by Microsoft Planetary Computer (No API key needed)
STAC_API_URL=https://planetarycomputer.microsoft.com/api/stac/v1/search
STAC_COLLECTION=sentinel-2-l2a
DELTA_NBR_BURN_THRESHOLD=0.27

# Geospatial Indexing & Clustering Parameters
H3_RESOLUTION=8
SPATIAL_SEARCH_RADIUS_KM=5.0
EMITTER_MATCH_BUFFER_METERS=500.0
