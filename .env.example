# ==============================================================================
# GeoAI Industrial Fire Classifier - Environment Configuration Template
# ==============================================================================

# Application Environment
APP_NAME="GeoAI Industrial Fire Classifier"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=change_this_to_a_secure_32_byte_secret_key_in_production
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL / TimescaleDB / PostGIS Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=geoai_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Asynchronous SQLAlchemy connection string:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/geoai_db

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# External Telemetry & Remote Sensing (NASA FIRMS)
FIRMS_MAP_KEY=cc1453ca7f4aee96699a0c8d4a63b205
FIRMS_API_URL=https://firms.modaps.eosdis.nasa.gov/api/country/csv

# Geospatial Indexing & Detection Parameters
H3_RESOLUTION=8
SPATIAL_SEARCH_RADIUS_KM=5.0
EMITTER_MATCH_BUFFER_METERS=500.0
